        "aside": "",
        "color": "#e8ad91"
      },
      {
        "text": "Кому?",
        "name": "Макс",
        "aside": "",
        "color": "#b5cf9d"
      },
      {
        "text": "Ване.",
        "name": "Ярик",
        "aside": "",
        "color": "#e8ad91"
