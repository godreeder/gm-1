    "frames": [
      {
        "text": "Как ты прошла?",
        "name": "Коля",
        "aside": "",
        "color": "#a5d6ed"
      },
      {
        "text": "Через дверь.",
        "name": "Лида",
        "aside": "",
        "color": "#ecad8b"
      },
      {
        "text": "Это было сложно? У нас тут один специалист по дверям.",
        "name": "Макс",
        "aside": "",
        "color": "#b5cf9d"
      },
      {
        "text": "Ещё раз — и будете обсуждать при свечах.",
        "name": "Ярик",
        "aside": "",
        "color": "#e8ad91"
      },
      {
        "text": "Кто-то хочет кофе?",
        "name": "Валерка",
        "aside": "",
        "color": "#e7d2a0"
