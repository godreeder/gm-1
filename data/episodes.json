  {
    "art": "20-троица-против-лиды",
    "node": "2.02",
    "title": "Катя, Полина и Саша входят",
    "chapter": 2,
    "frames": [
      {
        "text": "Звук исчезает. Входят Катя, Полина и Саша.",
        "name": "",
        "aside": "",
